{
  "name": "mwap-web",
  "version": "0.0.2",
  "private": true,
  "description": "Web dashboard of MWap: create, publish and manage template-driven sites",
  "license": "MIT",
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Modest-Human-Brands/mwap-web.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vp dev",
    "detect": "gitleaks git --verbose",
    "lint": "vp lint . --fix",
    "format": "vp fmt src/",
    "test:unit": "vp test",
    "build": "vp build",
    "preview": "vp preview",
    "docker:build": "docker build --build-arg VERSION=dev --build-arg BUILD_TIME=now -t mwap-web:dev .",
    "docker:start": "docker run --detach --name mwap-web-dev --env-file .env.prod -p 5000:8080 mwap-web:dev"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.36.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@iconify-json/lucide": "^1.2.151",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "1.1.0",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "engines": {
    "bun": "^1.2.9",
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "pnpm": "^9.15.0 || ^10.2.0 || ^11.0.0"
  },
  "packageManager": "bun@1.4.3"
}