# Shared (Unprefixed)
ORGANIZATION_ID=default

# Scoped Service
# Google Analytics Measurement ID
VITE_MWAP_WEB_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_MWAP_WEB_SITE_URL=http://localhost:8080
# MWap service the browser calls directly
VITE_MWAP_WEB_API_URL=
# Where published sites are served (base/slug)
VITE_MWAP_WEB_SITES_URL=
# Optional wildcard domain: new sites also get <slug>.<domain>
VITE_MWAP_WEB_SITE_DOMAIN=
# Mocks toggle
VITE_MWAP_WEB_USE_MOCKS=true
VITE_MWAP_WEB_API_KEY=
