# Google Analytics Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Public site URL
VUE_PUBLIC_SITE_URL=http://localhost:8080

# MWap service the browser calls directly (empty = http://localhost:3001 in dev,
# https://wap.modesthumanbrands.com in production)
VITE_MWAP_API_URL=

# Where published sites are served (base/slug). Empty = the service: localhost:3001 in dev,
# https://wap.modesthumanbrands.com in production
VITE_MWAP_SITES_URL=

# Optional wildcard domain: new sites also get <slug>.<domain> (leave empty to use base/slug)
VITE_MWAP_SITE_DOMAIN=

# Features the backend lacks (status, analytics, activity, extra templates) come from mocks.
# Set to false to disable all mocks (not usable until the backend gains these features).
VITE_USE_MOCKS=true

# Sent as x-api-key / x-org-id on writes. In production set them as environment variables of the
# container: docker/runtime-config.sh writes them to /config.js on start, so no rebuild is needed.
# A browser cannot keep a secret: anyone can read /config.js. Use a proxy or real user auth later.
VITE_MWAP_API_KEY=
VITE_MWAP_ORG_ID=default
