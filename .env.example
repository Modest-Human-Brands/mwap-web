# Google Analytics Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Public site URL
VUE_PUBLIC_SITE_URL=http://localhost:8080

# MWap service the dev server proxies /api to
VITE_API_PROXY=http://localhost:3000

# Production API base URL (empty = same origin)
VITE_MWAP_API_URL=

# Where published sites are served (base/slug)
VITE_MWAP_SITES_URL=http://localhost:3000

# Optional wildcard domain: new sites also get <slug>.<domain> (leave empty to use base/slug)
VITE_MWAP_SITE_DOMAIN=

# Features the backend lacks (status, analytics, activity, extra templates) come from mocks.
# Set to false to disable all mocks (not usable until the backend gains these features).
VITE_USE_MOCKS=true

# DEV ONLY: sent as x-api-key / x-org-id on writes. A browser cannot keep a secret;
# production needs a proxy or real user auth before this is exposed.
VITE_MWAP_API_KEY=
VITE_MWAP_ORG_ID=default
